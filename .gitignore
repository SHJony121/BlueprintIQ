# ---------------------------------------------------------------------------
# Secrets and local configuration — never commit these
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
secrets/
credentials*.json
service-account*.json

# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/
wheels/

# Virtual environments
.venv/
venv/
env/
ENV/

# Tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.pyright/
.hypothesis/
.tox/
.nox/

# Coverage
.coverage
.coverage.*
htmlcov/
coverage.xml

# ---------------------------------------------------------------------------
# Node.js / Next.js (frontend, later phase)
# ---------------------------------------------------------------------------
node_modules/
.next/
out/
.turbo/
.vercel/
*.tsbuildinfo
next-env.d.ts
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---------------------------------------------------------------------------
# Local data, databases, and generated runtime output
# (synthetic test fixtures under tests/ ARE committed — do not ignore *.pdf globally)
# ---------------------------------------------------------------------------
*.db
*.sqlite
*.sqlite3
*.db-journal
data/uploads/
data/outputs/
reports/generated/
benchmarks/results/local/
tmp/
*.log

# ---------------------------------------------------------------------------
# Editors, OS, and agent-local settings
# ---------------------------------------------------------------------------
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini
.claude/settings.local.json
CLAUDE.local.md

# Claude Code session lock
.claude/scheduled_tasks.lock
